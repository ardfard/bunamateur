DATABASE_URL=postgres://ardfard@127.0.0.1:5432/bunamateur_dev
TEST_DATABASE_URL=postgres://ardfard@127.0.0.1:5432/bunamateur_test
HOST=127.0.0.1
PORT=8080

# Security & Authentication
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# Set to true behind HTTPS / in production (defaults to true when APP_ENV=production or non-localhost HOST)
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
# Set to true only when running behind a trusted reverse proxy (for X-Forwarded-For rate-limit IP)
TRUST_PROXY=false
# Set to production in deployed environments (requires ENCRYPTION_KEY and enables Secure cookies by default)
APP_ENV=development

# Transactional Email (pluggable EmailSender interface: resend | smtp | log)
# Auto-selects `resend` when RESEND_API_KEY is set, otherwise `log` (no outbound calls)
EMAIL_PROVIDER=log
EMAIL_FROM="BunAmateur <onboarding@resend.dev>"
APP_PUBLIC_URL=http://127.0.0.1:8080
RESEND_API_KEY=
# RESEND_API_BASE_URL=https://api.resend.com

# Reserved for future SMTP transport (EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=

# Google OAuth 2.0 / OIDC Login (PKCE S256)
# Configure Authorized Redirect URI in Google Cloud Console: <APP_PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/api/auth/google/callback

# Observability & Operations
# Set LOG_FORMAT=json for structured JSON logs in production
LOG_FORMAT=pretty
RUST_LOG=bunamateur=info,tower_http=info
# Optional bearer token required on GET /metrics when exposed publicly
# METRICS_BEARER_TOKEN=

# Pre-Generated Sentence Audio Pipeline (VOICEVOX / Azure Neural TTS / CDN)
# Pre-generated files in AUDIO_CACHE_DIR (sentence_<id>.opus|.mp3|.wav or <sha256>.opus|.mp3|.wav) are served first.
# Falls back gracefully to browser Web Speech API when no asset/provider is configured.
AUDIO_CACHE_DIR=./data/audio
# AUDIO_CDN_BASE_URL=https://cdn.example.com/bunamateur-audio
AUDIO_PROVIDER=none
# VOICEVOX_URL=http://127.0.0.1:50021
# VOICEVOX_SPEAKER_ID=3
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=japaneast
# AZURE_SPEECH_VOICE=ja-JP-NanamiNeural
